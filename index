    if(pageOf[id]) return pageOf[id];
    var el = document.getElementById(id);
    var p = el && el.closest('[data-page]');
    return p ? p.getAttribute('data-page') : 'home';
  }
  function show(id, instant){
    id = id || 'top';
    var pg = pageForId(id);
    pages.forEach(function(el){ el.classList.toggle('pg-on', el.getAttribute('data-page') === pg); });
    links.forEach(function(a){
      var tid = (a.getAttribute('href')||'').slice(1);
      a.classList.toggle('on', tid === id || (pageForId(tid) === pg && tid === id));
    });
    var target = document.getElementById(id);
    var isPageStart = !target || id === 'top' || (target.getAttribute && target.hasAttribute('data-page'));
    if(isPageStart){ window.scrollTo(0,0); }
    else { setTimeout(function(){ target.scrollIntoView(); }, 30); }
  }
  document.addEventListener('click', function(e){
    var a = e.target.closest && e.target.closest('a[href^="#"]');
    if(!a || a.getAttribute('href').length < 2) return;
    var id = a.getAttribute('href').slice(1);
    e.preventDefault();
    try{ history.pushState(null,'','#'+id); }catch(err){}
    show(id);
  });
  window.addEventListener('popstate', function(){ show(location.hash.slice(1)); });
  show(location.hash.slice(1));
})();
</script>

</body></html>
